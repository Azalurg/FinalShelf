{
  "build": {
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/finalshelf/browser",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "finalshelf",
  "mainBinaryName": "finalshelf",
  "version": "0.3.2",
  "identifier": "com.finalshelf.app",
  "plugins": {},
  "app": {
    "security": {
      "assetProtocol": {
        "scope": [
          "/**/*"
        ],
        "enable": true
      },
      "csp": null
    },
    "windows": [
      {
        "title": "FinalShelf",
        "width": 1360,
        "height": 850,
        "useHttpsScheme": true
      }
    ]
  }
}